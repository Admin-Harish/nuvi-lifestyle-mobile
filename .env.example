# Nuvi Lifestyle mobile — build variable NAMES ONLY.
#
# This file is committed and must never contain a real value.
#
# Flutter reads configuration at COMPILE time via --dart-define, not from a
# .env file at runtime. Keep the real values in your shell, your CI secret
# store, or a local .env you source before building — never in the repository.
#
#     source .env
#     flutter run -t lib/main_dev.dart --dart-define=API_BASE_URL=$API_BASE_URL
#
# Or use the helper, which reads these names from the environment:
#
#     ./scripts/run.sh dev
#     ./scripts/build.sh staging

# Base URL of the Nuvi Lifestyle API, with scheme and no trailing slash.
# Required for staging and production builds; the app refuses to start without
# it. Production additionally requires https://.
API_BASE_URL=

# Request timeout in seconds. Optional; defaults to 30.
API_TIMEOUT_SECONDS=
